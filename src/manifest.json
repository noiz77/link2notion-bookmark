{
  "manifest_version": 3,
  "name": "Notion 导入助手",
  "version": "5.2.7",
  "description": "链接/文章/推文导入Notion，自动抓取内容、支持手动选择",
  "permissions": [
    "storage",
    "cookies",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.notion.so/*",
    "https://app.notion.com/*",
    "*://*/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "导入书签",
    "default_icon": {
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "128": "assets/icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
